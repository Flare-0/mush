{
  "name": "archivetune-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Electron desktop port of ArchiveTune (1:1 replica attempt)",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:renderer": "tsc -b && vite build",
    "start": "electron .",
    "dev:electron": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "lint": "oxlint"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.archivetune.desktop",
    "productName": "ArchiveTune Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "arch": [
        "x64"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    }
  }
}
